<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="p2-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#042f2e" />
    </linearGradient>
    <linearGradient id="p2-cyan" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="100%" stop-color="#10b981" />
    </linearGradient>
    <linearGradient id="p2-card" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.07" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02" />
    </linearGradient>
    <filter id="p2-shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#000000" flood-opacity="0.5"/>
    </filter>
  </defs>

  <rect width="800" height="500" fill="url(#p2-bg)"/>

  <!-- App Window -->
  <g transform="translate(50, 40)" filter="url(#p2-shadow)">
    <rect width="700" height="420" rx="12" fill="#0f172a" stroke="#1e293b" stroke-width="1.5"/>
    <rect width="700" height="40" rx="12" fill="#020617"/>
    <!-- Dots -->
    <circle cx="24" cy="20" r="6" fill="#ef4444"/>
    <circle cx="44" cy="20" r="6" fill="#f59e0b"/>
    <circle cx="64" cy="20" r="6" fill="#10b981"/>
    <!-- Top Search / Command Palette -->
    <rect x="150" y="10" width="400" height="22" rx="6" fill="#1e293b"/>
    <text x="170" y="25" fill="#64748b" font-family="monospace" font-size="11">🔍 Search traces, p99 latency, or cluster events...</text>

    <!-- Content Grid -->
    <g transform="translate(30, 60)">
      <!-- Left Column: Real-time logs stream -->
      <g>
        <rect width="300" height="330" rx="8" fill="#030712" stroke="#1e293b" stroke-width="1"/>
        <rect width="300" height="34" rx="8" fill="#111827"/>
        <text x="16" y="22" fill="#38bdf8" font-family="monospace" font-size="12" font-weight="bold">&gt;_ LIVE TELEMETRY STREAM</text>
        
        <!-- Log lines -->
        <text x="14" y="60" fill="#22c55e" font-family="monospace" font-size="10">[INFO] 02:45:11 [auth-svc] Token verified (0.4ms)</text>
        <text x="14" y="85" fill="#38bdf8" font-family="monospace" font-size="10">[HTTP] GET /api/v2/metrics 200 OK (1.2ms)</text>
        <text x="14" y="110" fill="#22c55e" font-family="monospace" font-size="10">[INFO] ClickHouse buffer flushed: 45.2k rows</text>
        <text x="14" y="135" fill="#f59e0b" font-family="monospace" font-size="10">[WARN] Cache miss: key:user_meta_9821</text>
        <text x="14" y="160" fill="#22c55e" font-family="monospace" font-size="10">[INFO] Redis replica synced (lag: 0ms)</text>
        <text x="14" y="185" fill="#38bdf8" font-family="monospace" font-size="10">[HTTP] POST /v1/ingest - 202 Accepted</text>
        <text x="14" y="210" fill="#22c55e" font-family="monospace" font-size="10">[INFO] Node worker-08 healthy: CPU 24%</text>
        <text x="14" y="235" fill="#a855f7" font-family="monospace" font-size="10">[TRACE] trace_id=8f01a3 span_id=4c09</text>
        <text x="14" y="260" fill="#22c55e" font-family="monospace" font-size="10">[INFO] P99 Latency: 14.8ms (Target: &lt;50ms)</text>
        <text x="14" y="285" fill="#10b981" font-family="monospace" font-size="10">✔ All 12 Microservices reporting green</text>
      </g>

      <!-- Right Column: Graphs and Health -->
      <g transform="translate(320, 0)">
        <!-- Box 1: Latency distribution -->
        <rect width="320" height="155" rx="8" fill="url(#p2-card)" stroke="#1e293b" stroke-width="1"/>
        <text x="16" y="25" fill="#e2e8f0" font-family="sans-serif" font-size="13" font-weight="600">p99 Latency by Microservice</text>
        
        <!-- Bars -->
        <text x="16" y="55" fill="#94a3b8" font-family="monospace" font-size="10">gateway-api</text>
        <rect x="90" y="46" width="180" height="12" rx="3" fill="#10b981"/>
        <text x="275" y="56" fill="#10b981" font-family="monospace" font-size="10">8ms</text>

        <text x="16" y="85" fill="#94a3b8" font-family="monospace" font-size="10">auth-cluster</text>
        <rect x="90" y="76" width="140" height="12" rx="3" fill="#06b6d4"/>
        <text x="235" y="86" fill="#06b6d4" font-family="monospace" font-size="10">4ms</text>

        <text x="16" y="115" fill="#94a3b8" font-family="monospace" font-size="10">ingest-engine</text>
        <rect x="90" y="106" width="210" height="12" rx="3" fill="#3b82f6"/>
        <text x="305" y="116" fill="#3b82f6" font-family="monospace" font-size="10">12ms</text>

        <text x="16" y="145" fill="#94a3b8" font-family="monospace" font-size="10">db-proxy</text>
        <rect x="90" y="136" width="160" height="12" rx="3" fill="#8b5cf6"/>
        <text x="255" y="146" fill="#8b5cf6" font-family="monospace" font-size="10">6ms</text>

        <!-- Box 2: Node Topology -->
        <g transform="translate(0, 170)">
          <rect width="320" height="160" rx="8" fill="url(#p2-card)" stroke="#1e293b" stroke-width="1"/>
          <text x="16" y="25" fill="#e2e8f0" font-family="sans-serif" font-size="13" font-weight="600">Kubernetes Node Mesh Status</text>
          
          <g transform="translate(20, 50)">
            <circle cx="30" cy="40" r="22" fill="#064e3b" stroke="#10b981" stroke-width="2"/>
            <text x="30" y="44" fill="#34d399" font-family="monospace" font-size="10" text-anchor="middle">node-1</text>
            
            <circle cx="140" cy="20" r="22" fill="#064e3b" stroke="#10b981" stroke-width="2"/>
            <text x="140" y="24" fill="#34d399" font-family="monospace" font-size="10" text-anchor="middle">node-2</text>

            <circle cx="140" cy="70" r="22" fill="#064e3b" stroke="#10b981" stroke-width="2"/>
            <text x="140" y="74" fill="#34d399" font-family="monospace" font-size="10" text-anchor="middle">node-3</text>

            <circle cx="250" cy="40" r="22" fill="#064e3b" stroke="#10b981" stroke-width="2"/>
            <text x="250" y="44" fill="#34d399" font-family="monospace" font-size="10" text-anchor="middle">node-4</text>

            <!-- Lines -->
            <line x1="52" y1="35" x2="118" y2="25" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3,3"/>
            <line x1="52" y1="45" x2="118" y2="65" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3,3"/>
            <line x1="162" y1="25" x2="228" y2="35" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3,3"/>
            <line x1="162" y1="65" x2="228" y2="45" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3,3"/>
          </g>
        </g>
      </g>
    </g>
  </g>
</svg>
