<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <style>
      @keyframes pulseBeam {
        0%, 100% { transform: scaleX(0.2); opacity: 0.3; }
        50% { transform: scaleX(1); opacity: 1; }
      }
      @keyframes floatDot {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-12px); }
        100% { transform: translateY(0px); }
      }
      @keyframes radarSweep {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      @keyframes waveLine {
        0% { stroke-dashoffset: 0; }
        100% { stroke-dashoffset: -200; }
      }
      .beam-line {
        animation: waveLine 4s linear infinite;
        stroke-dasharray: 12, 12;
      }
      .floating-node {
        animation: floatDot 3s ease-in-out infinite;
      }
    </style>
    <linearGradient id="demo-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16"/>
      <stop offset="100%" stop-color="#1e1b4b"/>
    </linearGradient>
    <linearGradient id="glow-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="50%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
  </defs>

  <rect width="800" height="450" fill="url(#demo-bg)"/>

  <!-- Radial grid backdrop -->
  <circle cx="400" cy="225" r="180" fill="none" stroke="#334155" stroke-width="1" stroke-dasharray="4,4" opacity="0.3"/>
  <circle cx="400" cy="225" r="120" fill="none" stroke="#6366f1" stroke-width="1" stroke-dasharray="6,6" opacity="0.4"/>
  <circle cx="400" cy="225" r="60" fill="none" stroke="#06b6d4" stroke-width="1" opacity="0.6"/>

  <!-- Central Engine Core -->
  <circle cx="400" cy="225" r="38" fill="#1e1b4b" stroke="url(#glow-grad)" stroke-width="3"/>
  <text x="400" y="231" fill="#ffffff" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">&lt;CORE/&gt;</text>

  <!-- Connected Nodes with Animated Beams -->
  <!-- Top Node -->
  <line x1="400" y1="187" x2="400" y2="90" stroke="#6366f1" stroke-width="2.5" class="beam-line"/>
  <g transform="translate(400, 75)" class="floating-node">
    <rect x="-85" y="-22" width="170" height="44" rx="8" fill="#0f172a" stroke="#6366f1" stroke-width="2"/>
    <text x="0" y="5" fill="#a5b4fc" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">⚡ Real-time GraphQL</text>
  </g>

  <!-- Left Node -->
  <line x1="362" y1="225" x2="160" y2="225" stroke="#a855f7" stroke-width="2.5" class="beam-line"/>
  <g transform="translate(140, 225)" class="floating-node" style="animation-delay: -1s;">
    <rect x="-80" y="-22" width="160" height="44" rx="8" fill="#0f172a" stroke="#a855f7" stroke-width="2"/>
    <text x="0" y="5" fill="#f472b6" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">🧠 AI Model Pipeline</text>
  </g>

  <!-- Right Node -->
  <line x1="438" y1="225" x2="640" y2="225" stroke="#06b6d4" stroke-width="2.5" class="beam-line"/>
  <g transform="translate(660, 225)" class="floating-node" style="animation-delay: -2s;">
    <rect x="-80" y="-22" width="160" height="44" rx="8" fill="#0f172a" stroke="#06b6d4" stroke-width="2"/>
    <text x="0" y="5" fill="#38bdf8" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">📊 ClickHouse Telemetry</text>
  </g>

  <!-- Bottom Node -->
  <line x1="400" y1="263" x2="400" y2="360" stroke="#10b981" stroke-width="2.5" class="beam-line"/>
  <g transform="translate(400, 375)" class="floating-node" style="animation-delay: -1.5s;">
    <rect x="-85" y="-22" width="170" height="44" rx="8" fill="#0f172a" stroke="#10b981" stroke-width="2"/>
    <text x="0" y="5" fill="#34d399" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">🛡️ Automated CI/CD CDNs</text>
  </g>

  <!-- Realtime Pulse Badge -->
  <g transform="translate(400, 425)">
    <text x="0" y="0" fill="#94a3b8" font-family="monospace" font-size="11" text-anchor="middle">● LIVE ARCHITECTURE PREVIEW &amp; INTERACTIVE DEMO</text>
  </g>
</svg>
