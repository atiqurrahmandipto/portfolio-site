<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="p1-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <linearGradient id="p1-accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#6366f1" />
      <stop offset="100%" stop-color="#a855f7" />
    </linearGradient>
    <linearGradient id="card-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02" />
    </linearGradient>
    <filter id="p1-shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#000000" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="500" fill="url(#p1-bg)"/>
  
  <!-- Subtle Grid Accent -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <pattern id="p1-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none"/>
    </pattern>
    <rect width="800" height="500" fill="url(#p1-grid)"/>
  </g>

  <!-- Window Frame / App Mockup -->
  <g transform="translate(50, 40)" filter="url(#p1-shadow)">
    <!-- Browser Header -->
    <rect width="700" height="420" rx="12" fill="#1e293b" stroke="#334155" stroke-width="1.5"/>
    <rect width="700" height="40" rx="12" fill="#0f172a"/>
    <!-- Browser Dots -->
    <circle cx="24" cy="20" r="6" fill="#ef4444"/>
    <circle cx="44" cy="20" r="6" fill="#f59e0b"/>
    <circle cx="64" cy="20" r="6" fill="#10b981"/>
    <!-- URL Bar -->
    <rect x="120" y="10" width="460" height="20" rx="6" fill="#1e293b" stroke="#334155" stroke-width="1"/>
    <text x="350" y="24" fill="#94a3b8" font-family="monospace" font-size="11" text-anchor="middle">https://cloudscale.ai/workspace/dashboard</text>
    
    <!-- Sidebar -->
    <rect x="0" y="40" width="160" height="380" fill="#0f172a" opacity="0.7"/>
    <rect x="20" y="65" width="120" height="12" rx="4" fill="#6366f1"/>
    <rect x="20" y="95" width="90" height="8" rx="3" fill="#334155"/>
    <rect x="20" y="115" width="105" height="8" rx="3" fill="#334155"/>
    <rect x="20" y="135" width="80" height="8" rx="3" fill="#334155"/>
    <rect x="20" y="155" width="100" height="8" rx="3" fill="#334155"/>

    <!-- Main Content Area -->
    <!-- Metric Cards -->
    <g transform="translate(180, 60)">
      <!-- Card 1 -->
      <rect width="155" height="80" rx="8" fill="url(#card-grad)" stroke="#334155" stroke-width="1"/>
      <text x="16" y="26" fill="#94a3b8" font-family="sans-serif" font-size="11">Total Workspaces</text>
      <text x="16" y="54" fill="#ffffff" font-family="sans-serif" font-size="20" font-weight="bold">14,820</text>
      <text x="16" y="70" fill="#10b981" font-family="sans-serif" font-size="10">↑ +18.4% this wk</text>
      
      <!-- Card 2 -->
      <g transform="translate(170, 0)">
        <rect width="155" height="80" rx="8" fill="url(#card-grad)" stroke="#334155" stroke-width="1"/>
        <text x="16" y="26" fill="#94a3b8" font-family="sans-serif" font-size="11">AI Inference Tokens</text>
        <text x="16" y="54" fill="#38bdf8" font-family="sans-serif" font-size="20" font-weight="bold">48.2M</text>
        <text x="16" y="70" fill="#10b981" font-family="sans-serif" font-size="10">↑ 99.98% SLA</text>
      </g>

      <!-- Card 3 -->
      <g transform="translate(340, 0)">
        <rect width="155" height="80" rx="8" fill="url(#card-grad)" stroke="#334155" stroke-width="1"/>
        <text x="16" y="26" fill="#94a3b8" font-family="sans-serif" font-size="11">Active GPU Clusters</text>
        <text x="16" y="54" fill="#a855f7" font-family="sans-serif" font-size="20" font-weight="bold">128 H100s</text>
        <text x="16" y="70" fill="#a855f7" font-family="sans-serif" font-size="10">● Auto-scaled</text>
      </g>
    </g>

    <!-- Graph / Chart Area -->
    <g transform="translate(180, 160)">
      <rect width="495" height="235" rx="8" fill="url(#card-grad)" stroke="#334155" stroke-width="1"/>
      <text x="20" y="30" fill="#f8fafc" font-family="sans-serif" font-size="14" font-weight="600">Real-Time Throughput &amp; Model Execution</text>
      <!-- Grid lines -->
      <line x1="20" y1="80" x2="475" y2="80" stroke="#334155" stroke-width="0.7" stroke-dasharray="4,4"/>
      <line x1="20" y1="130" x2="475" y2="130" stroke="#334155" stroke-width="0.7" stroke-dasharray="4,4"/>
      <line x1="20" y1="180" x2="475" y2="180" stroke="#334155" stroke-width="0.7" stroke-dasharray="4,4"/>
      
      <!-- Gradient Fill under chart curve -->
      <path d="M 30 190 Q 90 140, 150 160 T 270 100 T 390 120 T 465 60 L 465 210 L 30 210 Z" fill="url(#p1-accent)" opacity="0.2"/>
      <!-- Chart line -->
      <path d="M 30 190 Q 90 140, 150 160 T 270 100 T 390 120 T 465 60" fill="none" stroke="url(#p1-accent)" stroke-width="3.5" stroke-linecap="round"/>
      
      <!-- Data points -->
      <circle cx="150" cy="160" r="4" fill="#a855f7"/>
      <circle cx="270" cy="100" r="4" fill="#6366f1"/>
      <circle cx="465" cy="60" r="5" fill="#38bdf8"/>
    </g>
  </g>
</svg>
