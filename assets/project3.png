<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="p3-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f19" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <linearGradient id="p3-pink" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ec4899" />
      <stop offset="100%" stop-color="#f43f5e" />
    </linearGradient>
    <linearGradient id="p3-card" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02" />
    </linearGradient>
    <filter id="p3-shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#000000" flood-opacity="0.5"/>
    </filter>
  </defs>

  <rect width="800" height="500" fill="url(#p3-bg)"/>

  <!-- App Window -->
  <g transform="translate(50, 40)" filter="url(#p3-shadow)">
    <rect width="700" height="420" rx="12" fill="#0f172a" stroke="#334155" stroke-width="1.5"/>
    <rect width="700" height="40" rx="12" fill="#020617"/>
    <!-- Dots -->
    <circle cx="24" cy="20" r="6" fill="#ef4444"/>
    <circle cx="44" cy="20" r="6" fill="#f59e0b"/>
    <circle cx="64" cy="20" r="6" fill="#10b981"/>
    <!-- Search / URL -->
    <rect x="150" y="10" width="400" height="22" rx="6" fill="#1e293b"/>
    <text x="350" y="25" fill="#ec4899" font-family="monospace" font-size="11" text-anchor="middle">https://omniflow.store/analytics/checkout-pipeline</text>

    <!-- Main Store Pipeline Area -->
    <g transform="translate(30, 60)">
      <!-- Top Row Stat Cards -->
      <g>
        <rect width="200" height="75" rx="8" fill="url(#p3-card)" stroke="#334155" stroke-width="1"/>
        <text x="16" y="24" fill="#94a3b8" font-family="sans-serif" font-size="11">Gross Merchandise Vol (GMV)</text>
        <text x="16" y="52" fill="#ffffff" font-family="sans-serif" font-size="20" font-weight="bold">$1,420,890</text>
        <text x="16" y="68" fill="#10b981" font-family="sans-serif" font-size="10">↑ +32.4% MoM</text>
      </g>

      <g transform="translate(220, 0)">
        <rect width="200" height="75" rx="8" fill="url(#p3-card)" stroke="#334155" stroke-width="1"/>
        <text x="16" y="24" fill="#94a3b8" font-family="sans-serif" font-size="11">Checkout Conversion Rate</text>
        <text x="16" y="52" fill="#f43f5e" font-family="sans-serif" font-size="20" font-weight="bold">4.82%</text>
        <text x="16" y="68" fill="#10b981" font-family="sans-serif" font-size="10">↑ 1.2s avg checkout speed</text>
      </g>

      <g transform="translate(440, 0)">
        <rect width="200" height="75" rx="8" fill="url(#p3-card)" stroke="#334155" stroke-width="1"/>
        <text x="16" y="24" fill="#94a3b8" font-family="sans-serif" font-size="11">Redis Cache Hit Ratio</text>
        <text x="16" y="52" fill="#38bdf8" font-family="sans-serif" font-size="20" font-weight="bold">98.6%</text>
        <text x="16" y="68" fill="#38bdf8" font-family="sans-serif" font-size="10">● Distributed cluster</text>
      </g>

      <!-- Bottom: Visual Checkout Pipeline Flow -->
      <g transform="translate(0, 95)">
        <rect width="640" height="235" rx="8" fill="url(#p3-card)" stroke="#334155" stroke-width="1"/>
        <text x="20" y="30" fill="#f8fafc" font-family="sans-serif" font-size="14" font-weight="600">Event-Driven Distributed Checkout Pipeline</text>
        
        <!-- Step 1: Cart Service -->
        <g transform="translate(20, 60)">
          <rect width="125" height="135" rx="8" fill="#1e293b" stroke="#ec4899" stroke-width="1.5"/>
          <circle cx="62" cy="35" r="18" fill="#831843"/>
          <text x="62" y="40" fill="#f472b6" font-family="sans-serif" font-size="14" text-anchor="middle">🛒</text>
          <text x="62" y="75" fill="#f8fafc" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Cart Service</text>
          <text x="62" y="95" fill="#94a3b8" font-family="monospace" font-size="10" text-anchor="middle">Node/Redis</text>
          <text x="62" y="115" fill="#22c55e" font-family="monospace" font-size="9" text-anchor="middle">0.8ms read</text>
        </g>

        <!-- Arrow 1 -->
        <path d="M 150 125 L 180 125" stroke="#ec4899" stroke-width="2" stroke-dasharray="3,3"/>

        <!-- Step 2: Payment Gateway -->
        <g transform="translate(185, 60)">
          <rect width="125" height="135" rx="8" fill="#1e293b" stroke="#6366f1" stroke-width="1.5"/>
          <circle cx="62" cy="35" r="18" fill="#312e81"/>
          <text x="62" y="40" fill="#818cf8" font-family="sans-serif" font-size="14" text-anchor="middle">💳</text>
          <text x="62" y="75" fill="#f8fafc" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Stripe Webhook</text>
          <text x="62" y="95" fill="#94a3b8" font-family="monospace" font-size="10" text-anchor="middle">Idempotent</text>
          <text x="62" y="115" fill="#22c55e" font-family="monospace" font-size="9" text-anchor="middle">100% verified</text>
        </g>

        <!-- Arrow 2 -->
        <path d="M 315 125 L 345 125" stroke="#6366f1" stroke-width="2" stroke-dasharray="3,3"/>

        <!-- Step 3: Order SQS Queue -->
        <g transform="translate(350, 60)">
          <rect width="125" height="135" rx="8" fill="#1e293b" stroke="#f59e0b" stroke-width="1.5"/>
          <circle cx="62" cy="35" r="18" fill="#78350f"/>
          <text x="62" y="40" fill="#fbbf24" font-family="sans-serif" font-size="14" text-anchor="middle">⚡</text>
          <text x="62" y="75" fill="#f8fafc" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Kafka / SQS</text>
          <text x="62" y="95" fill="#94a3b8" font-family="monospace" font-size="10" text-anchor="middle">Async Broker</text>
          <text x="62" y="115" fill="#22c55e" font-family="monospace" font-size="9" text-anchor="middle">15k msgs/s</text>
        </g>

        <!-- Arrow 3 -->
        <path d="M 480 125 L 510 125" stroke="#f59e0b" stroke-width="2" stroke-dasharray="3,3"/>

        <!-- Step 4: Fulfillment & DB -->
        <g transform="translate(515, 60)">
          <rect width="105" height="135" rx="8" fill="#1e293b" stroke="#10b981" stroke-width="1.5"/>
          <circle cx="52" cy="35" r="18" fill="#064e3b"/>
          <text x="52" y="40" fill="#34d399" font-family="sans-serif" font-size="14" text-anchor="middle">📦</text>
          <text x="52" y="75" fill="#f8fafc" font-family="sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Fulfillment</text>
          <text x="52" y="95" fill="#94a3b8" font-family="monospace" font-size="10" text-anchor="middle">PostgreSQL</text>
          <text x="52" y="115" fill="#10b981" font-family="monospace" font-size="9" text-anchor="middle">ACID Compliant</text>
        </g>
      </g>
    </g>
  </g>
</svg>
